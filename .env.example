# Gmail account used to send alerts
GMAIL_ADDRESS=your-account@gmail.com

# Gmail App Password (NOT your normal password) - see README for setup
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where alerts are delivered (can be the same as GMAIL_ADDRESS)
ALERT_RECIPIENT_EMAIL=recipient@example.com

# Must be "true" to allow any real email to be sent. Defaults to dry-run otherwise.
ENABLE_LIVE_EMAIL=false

# Optional tuning (defaults shown)
MAX_READING_AGE_MINUTES=150
NOTIFICATION_INTERVAL_SECONDS=3600
PM25_STATE_FILE=state.json
